{
  "name": "ok-tierlist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler deploy",
    "check:bindings": "node scripts/check-bindings.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@cloudflare/workers-types": "latest",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "dependencies": {
    "@dicebear/core": "latest",
    "@dicebear/shapes": "latest"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "undici": "^7.29.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "version": "0.1.0"
}
